# ─── Hostnames ────────────────────────────────────────────────────────────
# No domain is written down anywhere in the source. These two values are the
# only place this deployment learns its own name.

# The public origin — no trailing slash. Every canonical URL, the sitemap, the
# Open Graph tags and the JSON-LD are built from it.
# Read at BUILD time for statically rendered metadata: set it before next build.
SITE_URL=https://chennaiturboriders.in

# Hosts that serve the ADMIN instead of the public site, comma-separated.
# One deployment answers on both; src/middleware.ts routes on the Host header.
# Unset means NO host is the admin host — the admin is then unreachable and the
# public site is unaffected, which is the safe way round to fail.
# Must be set at BUILD time as well as run time: middleware runs in the Edge
# runtime, where process.env is inlined when the app is compiled.
# In development, ports 4000 and 127.0.0.1:4000 are added automatically.
ADMIN_HOSTS=admin.chennaiturboriders.in

# Set to 1 ONLY behind a proxy you control that overwrites x-forwarded-host.
# The header is client-supplied, so trusting it elsewhere lets anyone ask the
# public domain for admin routing. Vercel, Render, Fly and Railway need nothing.
# TRUST_FORWARDED_HOST=1

# ─── Services ─────────────────────────────────────────────────────────────

# Neon Postgres — site content, admin accounts, admin sessions.
# Every table this project owns lives in the `ctr` schema, so it can share a
# database with another CTR site without colliding with its tables.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Media bucket — everything uploaded from the media library.
# Leave unset to run the admin with pasted image URLs only.
#
# Neon object storage (the default): S3_ENDPOINT is the branch storage endpoint
# from the Neon Console (Object storage tab). Setting it switches the client to
# path-style addressing, which Neon requires, and a public_read bucket serves
# objects straight from S3_ENDPOINT/S3_BUCKET/<key>.
# Plain AWS S3: leave S3_ENDPOINT empty.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Where uploaded media is SERVED from, no trailing slash: S3_ENDPOINT/S3_BUCKET for
# a public_read Neon bucket, or the CloudFront distribution in front of an AWS one. Two things read it: the upload route, which
# writes this host into the database with every new image, and src/config/media.ts,
# which the preconnect is built from.
# Unset means uploads fall back to the bucket's own address (path-style under
# S3_ENDPOINT, else https://<bucket>.s3.<region>.amazonaws.com), which only works
# while the bucket is publicly readable.
# NEXT_PUBLIC_, so it is inlined at BUILD time: on Vercel, changing it needs a
# redeploy, not a restart. Rows written before it was set keep the old hostname.
NEXT_PUBLIC_MEDIA_BASE_URL=https://br-xxx.storage.c-N.REGION.aws.neon.tech/your-bucket

# Predates the variable above and still wins if set, for a deployment that had it
# first. Same meaning; there is no reason to set both.
# S3_PUBLIC_BASE_URL=https://media.chennaiturboriders.in

